{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "SignalR": {
      "PermitLimit": 30,
      "WindowSeconds": 10,
      "SegmentsPerWindow": 2
    }
  },
  "AllowedHosts": "*"
}
